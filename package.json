{
  "name": "tictacbrain",
  "private": true,
  "version": "1.0.0",
  "description": "Quiz QCM en mode série : enchaîne les bonnes réponses sans jamais te tromper.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "node scripts/question-bank.mjs",
    "test": "vitest run",
    "check": "npm run validate && tsc --noEmit && vitest run",
    "icons": "node scripts/generate-icons.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
